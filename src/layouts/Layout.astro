---
interface Props {
  title?: string;
  scorri?: boolean;
  bloccata?: boolean;
}

const { title = 'Soglia', scorri = false, bloccata = false } = Astro.props;
const classi = [scorri && 'scorri', bloccata && 'bloccata'].filter(Boolean).join(' ') || undefined;
---

<!doctype html>
<html lang="it" class={classi}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@500;700&display=swap" rel="stylesheet" />
  </head>
  <body class={classi}>
    <slot />
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    background: #000;
    color: #f4e6d6;
    font-family: Nunito, "Trebuchet MS", "Segoe UI", system-ui, sans-serif;
    font-weight: 500;
  }

  html.scorri,
  body.scorri {
    height: auto;
    min-height: 100%;
    overflow-x: hidden;
    overflow-y: auto;
  }

  html.scorri {
    scroll-snap-type: y proximity;
    scroll-behavior: smooth;
  }

  body.bloccata {
    overflow: hidden;
  }

  .sfera-stage {
    position: fixed;
    inset: 0;
    z-index: 6;
    pointer-events: none;
  }

  .sfera-stage canvas {
    pointer-events: auto;
  }

  .sfera-stage canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
