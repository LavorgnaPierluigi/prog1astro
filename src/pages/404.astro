---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Non trovata">
  <main>
    <p>Questa pagina non c’è.</p>
    <a href="/">Torna all’ingresso</a>
  </main>
</Layout>

<style>
  main {
    min-height: 100%;
    display: grid;
    place-content: center;
    gap: 1.2rem;
    text-align: center;
    padding: 2rem;
  }

  p {
    margin: 0;
    letter-spacing: 0.08em;
  }

  a {
    color: rgba(230, 230, 234, 0.7);
    text-decoration: none;
    letter-spacing: 0.12em;
    font-size: 0.9rem;
  }

  a:hover {
    color: #e6e6ea;
  }
</style>
