---
import Layout from '../layouts/Layout.astro';
import Sfera from '../components/Sfera.astro';
---

<Layout title="Soglia">
  <Sfera mode="intro" />
  <div id="gioco">
    <p class="fine" hidden></p>
    <div class="riga" hidden>
      <span class="parola sx"></span>
      <div class="centro">
        <div class="puntini" aria-hidden="true"></div>
        <input
          class="campo"
          type="text"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          aria-label="Parola mancante"
          disabled
        />
      </div>
      <span class="parola dx"></span>
    </div>
  </div>
</Layout>

<style is:global>
  body {
    overflow: hidden;
  }

  .fine {
    position: fixed;
    inset: 0;
    z-index: 10;
    display: grid;
    place-items: center;
    margin: 0;
    font-size: clamp(28px, 5vw, 54px);
    letter-spacing: 0.22em;
    text-transform: lowercase;
    pointer-events: none;
    color: #e6e6ea;
  }

  .fine[hidden],
  .riga[hidden] {
    display: none !important;
  }

  .riga {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 9vh;
    z-index: 8;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: clamp(12px, 3vw, 40px);
    align-items: center;
    padding: 0 6vw;
    pointer-events: auto;
    transition: opacity 0.45s ease;
  }

  .riga.via,
  .riga.succhiate {
    opacity: 0;
  }

  .parola {
    font-size: clamp(16px, 2.3vw, 28px);
    letter-spacing: 0.14em;
    text-transform: lowercase;
    color: #e6e6ea;
  }

  .sx {
    text-align: right;
  }

  .dx {
    text-align: left;
  }

  .centro {
    position: relative;
    min-width: 8rem;
  }

  .puntini {
    display: flex;
    justify-content: center;
    gap: 0.4em;
  }

  .slot {
    width: 1.05em;
    min-height: 1.35em;
    text-align: center;
    border-bottom: 1px solid rgba(230, 230, 234, 0.72);
    font-size: clamp(16px, 2.3vw, 28px);
    letter-spacing: 0;
    line-height: 1.25;
    text-transform: lowercase;
  }

  .slot.vuoto {
    color: rgba(230, 230, 234, 0.4);
  }

  .slot.vuoto::after {
    content: '·';
  }

  .campo {
    position: absolute;
    inset: 0;
    opacity: 0;
    border: 0;
    padding: 0;
    margin: 0;
    font-size: 16px;
    background: transparent;
    color: transparent;
    caret-color: transparent;
  }

  .risucchio {
    position: fixed;
    margin: 0;
    pointer-events: none;
    z-index: 9;
    box-sizing: border-box;
    transition: transform 0.38s ease-in, opacity 0.38s ease-in;
  }
</style>
