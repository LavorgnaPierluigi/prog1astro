---
import Layout from '../layouts/Layout.astro';
import { percorso } from '../lib/percorso.js';
import '../styles/presentazione.css';
---

<Layout title="BLUBLINO" bloccata>
  <main class="presentazione apertura">
    <div class="sfondo-blob" id="sfondo-blob" aria-hidden="true"></div>

    <div class="presentazione-colonna">
      <div class="testi">
        <section class="schermata attiva">
          <p class="etichetta resto-apertura">un gioco di parole</p>
          <h1 class="titolo-apertura">BLUBLINO</h1>
          <p class="lead resto-apertura">Lento. Dolce. Senza fretta.</p>
          <a class="prova resto-apertura" href={percorso('gioco')}>Gioca</a>
        </section>

        <section class="schermata" aria-hidden="true">
          <p class="etichetta miele">lo scopo</p>
          <h2>Guardare le lettere, una alla volta.</h2>
          <p>
            BLUBLINO è un esercizio di lettura e scrittura.
            Aiuta a spezzare le parole, a metterle in ordine e a completarle,
            senza punteggio e senza classifica.
          </p>
        </section>

        <section class="schermata" aria-hidden="true">
          <p class="etichetta cielo">a chi è rivolto</p>
          <h2>Per i bambini con dislessia e altri DSA.</h2>
          <p>
            I colori sono pastello, da caramella. I suoni sono bassi e calmi.
            Le parole sono chiare. Un adulto può restare vicino,
            ma si può giocare anche da soli.
          </p>
        </section>

        <section class="schermata" aria-hidden="true">
          <p class="etichetta pesca">come si gioca</p>
          <h2>Italiano o inglese, poi tre prove.</h2>
          <ul>
            <li>Spostare le lettere</li>
            <li>Scrivere le sillabe</li>
            <li>Riempire i buchi</li>
          </ul>
        </section>

        <section class="schermata ultima" aria-hidden="true">
          <p class="etichetta">quando sei pronto</p>
          <a class="prova" href={percorso('gioco')}>Gioca</a>
        </section>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { mountPresentazione } from '../lib/presentazione.js';
  import { mountSfondoBlob } from '../lib/mount-sfondo-blob.js';

  const root = document.querySelector('.presentazione');
  const sfondo = document.getElementById('sfondo-blob');
  if (root instanceof HTMLElement) mountPresentazione(root);
  if (sfondo instanceof HTMLElement) mountSfondoBlob(sfondo);
</script>
